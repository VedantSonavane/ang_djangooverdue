DJANGO_SECRET_KEY=replace-with-a-private-random-value
DEBUG=0
ALLOWED_HOSTS=127.0.0.1,localhost

# Must match Laravel's DJANGO_SERVICE_KEY.
SERVICE_KEY=replace-with-the-shared-service-key

# Connect to the same MySQL database used by Laravel.
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
